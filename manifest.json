{
  "manifest_version": 3,
  "name": "ChatGPT Themer",
  "version": "1.0.0",
  "description": "Cambia la paleta de colores de ChatGPT: 20 temas, acento personalizado, ancho de chat, tipografía y modo compacto.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "ChatGPT Themer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["src/themes.js", "src/content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-enabled": {
      "suggested_key": { "default": "Alt+Shift+T" },
      "description": "Activar / desactivar el tema"
    },
    "cycle-theme": {
      "suggested_key": { "default": "Alt+Shift+K" },
      "description": "Pasar al siguiente tema"
    }
  }
}
